# Environment Configuration
# Neural Nexus Knowledge Graph Platform
# Copy this file to .env and fill in your values

# === Application ===
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# === Database Connections ===
# Neo4j - Core Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# PostgreSQL - User Accounts, Audit Logs, Chat History
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_graph

# Redis - Celery Task Queue
REDIS_URL=redis://localhost:6379/0

# === AI Services ===
# Ollama - Local LLM & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:latest
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Gemini API - Optional Cloud Intelligence Switch
GOOGLE_API_KEY=your_gemini_api_key

# === Azure Storage (Optional) ===
# AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
# AZURE_CONTAINER_NAME=knowledge-files

# === Performance Tuning ===
CELERY_WORKER_CONCURRENCY=4
MAX_CHUNK_PARALLEL=10
AI_REQUEST_TIMEOUT=30
CIRCUIT_BREAKER_THRESHOLD=5

# === Feature Flags ===
ENABLE_WEBSOCKET=true
ENABLE_PERFORMANCE_MODE=true
DEFAULT_LOD_LEVEL=balanced

# === JWT Settings ===
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
